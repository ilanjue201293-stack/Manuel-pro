# ------------------------------------------------------------
# Four variables YOU set manually in Vercel
# ------------------------------------------------------------
ILAN_PASSWORD=
NAIM_PASSWORD=
JUUL_PASSWORD=
RUBEN_PASSWORD=

# Optional. If omitted, the app safely derives its session-signing secret
# from the Supabase server secret already provided by the Vercel integration.
CHAT_SESSION_SECRET=

# ------------------------------------------------------------
# DO NOT normally create these yourself.
# The Vercel Supabase integration automatically provides them.
# They are listed here only so local development is possible.
# ------------------------------------------------------------
POSTGRES_URL_NON_POOLING=
POSTGRES_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
